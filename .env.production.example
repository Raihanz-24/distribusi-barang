APP_NAME="Pancor Mas"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://distribusi.example.com
APP_TIMEZONE=Asia/Jakarta
APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pancor_mas
DB_USERNAME=pancor_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAP_STYLE_URL=
MAP_DEFAULT_LATITUDE=-7.8669
MAP_DEFAULT_LONGITUDE=113.3090
MAP_DEFAULT_ZOOM=10
NEARBY_STORE_RADIUS_METERS=150
NEARBY_STORE_LIMIT=5
ROUTING_PROVIDER=local
OSRM_BASE_URL=
MAP_HTTP_TIMEOUT_SECONDS=10
MAP_CACHE_SECONDS=3600
ROUTE_UNIQUE_AREA_PER_DATE=true
ALLOW_OUTSIDE_ROUTE_VISITS=true
GEOCODING_BASE_URL=
GEOCODING_USER_AGENT="PancorMasStoreManagement/1.0"
GEOCODING_CACHE_SECONDS=86400
INDONESIA_CACHE_STORE=database

SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
